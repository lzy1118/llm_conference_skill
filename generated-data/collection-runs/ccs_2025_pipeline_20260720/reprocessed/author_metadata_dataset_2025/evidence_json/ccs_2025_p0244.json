      ],
      "font_size": 8.966,
      "raw_text": "We introduce the notion of committed vector oblivious linear eval-"
    },
    {
      "evidence_id": "pdf:p1:b35",
      "source": "pdf_layout",
      "field": "page_block",
      "page": 1,
      "bbox": [
        317.659,
        500.903,
        592.019,
        509.869
      ],
      "font_size": 8.966,
      "raw_text": "Vector oblivious linear evaluation (VOLE) is a type of protocol that"
    },
    {
      "evidence_id": "pdf:p1:b36",
      "source": "pdf_layout",
      "field": "page_block",
      "page": 1,
      "bbox": [
        53.798,
        489.944,
        299.915,
        498.91
      ],
      "font_size": 8.966,
      "raw_text": "uation (C-VOLE), which allows a party holding a pre-committed"
