      "field": "title",
      "raw_text": "ImportSnare: Directed \"Code Manual\" Hijacking in Retrieval-Augmented Code Generation"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
      "field": "year",
