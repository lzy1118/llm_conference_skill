    {
      "evidence_id": "tei:title",
      "source": "grobid_tei",
      "field": "title",
      "raw_text": "QV-net: Decentralized Self-Tallying Quadratic Voting with Maximal Ballot Secrecy"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
