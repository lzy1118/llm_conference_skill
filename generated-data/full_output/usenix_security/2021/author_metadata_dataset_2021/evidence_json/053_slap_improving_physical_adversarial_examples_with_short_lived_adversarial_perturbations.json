      "source": "grobid_tei",
      "field": "title",
      "raw_text": "SLAP: Improving Physical Adversarial Examples with Short-Lived Adversarial Perturbations"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
      "field": "year",
