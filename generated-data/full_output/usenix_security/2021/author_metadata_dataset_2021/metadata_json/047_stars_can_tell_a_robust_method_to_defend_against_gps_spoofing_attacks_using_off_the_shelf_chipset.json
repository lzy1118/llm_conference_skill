          "value": "Stars Can Tell: A Robust Method to Defend against GPS Spoofing Attacks using Off-the-shelf Chipset"
        }
      ],
      "year": [
        {
          "source": "grobid_tei",
          "value": "2021"
        },
        {
          "source": "selected",
