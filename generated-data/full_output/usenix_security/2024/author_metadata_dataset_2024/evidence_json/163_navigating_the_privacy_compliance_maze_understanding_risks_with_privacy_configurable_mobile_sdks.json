      "field": "title",
      "raw_text": "Navigating the Privacy Compliance Maze: Understanding Risks with Privacy-Configurable Mobile SDKs"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
      "field": "year",
