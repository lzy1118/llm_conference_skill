      "field": "title",
      "raw_text": "The Tools and Tactics Used in Intimate Partner Surveillance: An Analysis of Online Infidelity Forums"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
      "field": "year",
