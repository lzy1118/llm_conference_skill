        "font_size": 12.0,
        "raw_text": "This paper is included in the Proceedings of the 29th USENIX Security Symposium. August 12-14, 2020 978 -1-939133 -17-5 Open access to the Proceedings of the 29th USENIX Security Symposium is sponsored by USENIX.",
        "extractor": "pypdf_fallback"
