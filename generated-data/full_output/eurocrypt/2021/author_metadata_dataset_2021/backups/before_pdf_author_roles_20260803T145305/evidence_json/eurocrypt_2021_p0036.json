      "source": "grobid_tei",
      "field": "title",
      "raw_text": "On the Power of Expansion: More Efficient Constructions in the Random Probing Model"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
      "field": "year",
