      "field": "title",
      "raw_text": "SyzSpec: Specification Generation for Linux Kernel Fuzzing via Under-Constrained Symbolic Execution"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
      "field": "year",
