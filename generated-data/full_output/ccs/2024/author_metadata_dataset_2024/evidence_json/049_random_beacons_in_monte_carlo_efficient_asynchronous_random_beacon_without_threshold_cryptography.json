  "paper_id": "049_random_beacons_in_monte_carlo_efficient_asynchronous_random_beacon_without_threshold_cryptography",
  "evidence": [
    {
      "evidence_id": "tei:title",
      "source": "grobid_tei",
      "field": "title",
      "raw_text": "Random Beacons in Monte Carlo: Efficient Asynchronous Random Beacon without Threshold Cryptography"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
