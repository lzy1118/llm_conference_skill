{
  "paper_id": "125_a_general_framework_for_data_use_auditing_of_ml_models",
  "evidence": [
    {
      "evidence_id": "tei:title",
      "source": "grobid_tei",
      "field": "title",
      "raw_text": "A General Framework for Data-Use Auditing of ML Models"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
