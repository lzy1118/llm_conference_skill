      "field": "title",
      "raw_text": "Universally Composable Transaction Order Fairness: Refined Definitions and Adaptive Security"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
      "field": "year",
      "raw_text": "2025"
