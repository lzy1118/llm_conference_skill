      "field": "title",
      "raw_text": "Quantum Circuits of AES with a Low-Depth Linear Layer and a New Structure"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
      "field": "year",
      "raw_text": "2024"
