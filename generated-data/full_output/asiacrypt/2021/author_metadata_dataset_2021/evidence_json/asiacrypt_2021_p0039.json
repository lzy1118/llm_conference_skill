  "evidence": [
    {
      "evidence_id": "tei:title",
      "source": "grobid_tei",
      "field": "title",
      "raw_text": "Secure and Efficient Software Masking on Superscalar Pipelined Processors"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
      "field": "year",
