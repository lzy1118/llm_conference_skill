      "raw_text": "Mind the Propagation of States New Automatic Search Tool for Impossible Differentials and Impossible Polytopic Transitions"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
      "field": "year",
      "raw_text": "2020"
