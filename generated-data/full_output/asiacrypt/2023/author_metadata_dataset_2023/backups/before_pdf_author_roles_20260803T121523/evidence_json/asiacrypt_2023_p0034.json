      "field": "title",
      "raw_text": "Hidden Stabilizers, the Isogeny to Endomorphism Ring Problem and the Cryptanalysis of pSIDH"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
      "field": "year",
