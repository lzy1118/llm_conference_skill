      "evidence_id": "pdfplumber:abstract",
      "source": "pdf_layout",
      "field": "abstract",
      "raw_text": "We describe an adaptation of Schnorr's signature to the lat- tice setting, which relies on Gaussian convolution rather than flooding or rejection sampling as previous approaches. It does not involve any abort, can be proved secure in the ROM and QROM using existing anal- yses of the Fiat-Shamir transform, and enjoys smaller signature sizes (both asymptotically and for concrete security levels).",
      "extractor": "pdfplumber_section_boundary"
    },
