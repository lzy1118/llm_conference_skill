    {
      "evidence_id": "tei:title",
      "source": "grobid_tei",
      "field": "title",
      "raw_text": "SoftSpokenOT: Quieter OT Extension from Small-Field Silent VOLE in the Minicrypt Model"
    },
    {
      "evidence_id": "tei:year",
      "source": "grobid_tei",
      "field": "year",
