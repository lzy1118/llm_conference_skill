{
  "main_table": {
    "description": "Main output table for US institution author records",
    "fields": [
      {
        "name": "name",
        "type": "string",
        "description": "Author full name"
      },
      {
        "name": "year",
        "type": "integer",
        "description": "Publication year"
      },
      {
        "name": "article_tag",
        "type": "string",
        "description": "Format: {CONFERENCE}-{Paper Title}"
      },
      {
        "name": "author_order",
        "type": "integer",
        "description": "0-indexed author position"
      },
      {
        "name": "inst",
        "type": "string",
        "description": "Institution affiliation text"
      }
    ]
  },
  "audit_table": {
    "description": "Extended audit table with classification metadata",
    "fields": [
      {
        "name": "conference",
        "type": "string",
        "description": "Conference code (e.g., CRYPTO, USENIX_SECURITY)"
      },
      {
        "name": "paper_id",
        "type": "string",
        "description": "Source paper identifier"
      },
      {
        "name": "title",
        "type": "string",
        "description": "Full paper title"
      },
      {
        "name": "name",
        "type": "string",
        "description": "Author full name"
      },
      {
        "name": "year",
        "type": "integer",
        "description": "Publication year"
      },
      {
        "name": "article_tag",
        "type": "string",
        "description": "Format: {CONFERENCE}-{Paper Title}"
      },
      {
        "name": "author_order",
        "type": "integer",
        "description": "0-indexed author position"
      },
      {
        "name": "inst",
        "type": "string",
        "description": "Institution affiliation text"
      },
      {
        "name": "is_us_institution",
        "type": "boolean",
        "description": "Whether classified as US institution"
      },
      {
        "name": "classification_source",
        "type": "string",
        "description": "Source of classification: rule, override, source_pdf"
      },
      {
        "name": "classification_confidence",
        "type": "float",
        "description": "Confidence score 0.0-1.0"
      },
      {
        "name": "classification_reason",
        "type": "string",
        "description": "Reason for classification decision"
      }
    ]
  },
  "issues_table": {
    "description": "Data quality issues requiring review",
    "fields": [
      {
        "name": "conference",
        "type": "string",
        "description": "Conference code"
      },
      {
        "name": "year",
        "type": "string",
        "description": "Publication year"
      },
      {
        "name": "paper_id",
        "type": "string",
        "description": "Source paper identifier"
      },
      {
        "name": "title",
        "type": "string",
        "description": "Full paper title"
      },
      {
        "name": "issue",
        "type": "string",
        "description": "Issue type (e.g., author_affiliation_count_mismatch)"
      },
      {
        "name": "authors_count",
        "type": "string",
        "description": "Number of authors"
      },
      {
        "name": "affiliations_count",
        "type": "string",
        "description": "Number of affiliations"
      },
      {
        "name": "authors",
        "type": "string",
        "description": "Pipe-separated author names"
      },
      {
        "name": "affiliations",
        "type": "string",
        "description": "Pipe-separated affiliations"
      }
    ]
  }
}
